# ═══════════════════════════════════════════════════════════════════
#  SGS — Variables d'environnement (copier en .env et adapter)
# ═══════════════════════════════════════════════════════════════════

# Profil Spring (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# Base de données
DB_URL=jdbc:postgresql://localhost:5432/sgs_db
DB_USER=sgs_user
DB_PASSWORD=CHANGE_ME

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (minimum 512 bits pour HMAC-SHA512)
JWT_SECRET=CHANGE_ME_USE_MINIMUM_64_CHARS_RANDOM_STRING_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_MS=604800000

# Email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Stockage fichiers
STORAGE_TYPE=local
STORAGE_PATH=uploads/

# Serveur
SERVER_PORT=8080
